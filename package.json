{
  "name": "pm2-hawkeye",
  "version": "6.0.0",
  "description": "Modern web dashboard for PM2 processes, metrics, and log files",
  "type": "module",
  "main": "lib/transport/server.js",
  "scripts": {
    "copy:assets": "cp media/favicon/* public/",
    "build": "esbuild src/main.jsx --bundle --minify --format=iife --target=es2020 --outfile=public/app.js && esbuild src/login.jsx --bundle --minify --format=iife --target=es2020 --outfile=public/login.js && lessc public/styles.less public/styles.css && npm run copy:assets",
    "start": "npm run build && node lib/transport/server.js",
    "dev": "node esbuild.dev.mjs",
    "format": "prettier --write \"**/*.{js,jsx,mjs}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,mjs}\"",
    "lint": "eslint .",
    "test": "NODE_ENV=test mocha",
    "copyright": "node ./tools/copyright.js",
    "release": "node ./tools/release/release.js"
  },
  "author": "Christian Kellner",
  "keywords": [
    "pm2",
    "logs",
    "monitoring",
    "dashboard"
  ],
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/orangecoding/pm2-hawkeye/issues"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=7.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cookie": "^2.0.1",
    "cookie-parser": "^1.4.7",
    "croner": "^10.0.1",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "pm2": "^7.1.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@phosphor-icons/react": "^2.1.10",
    "chai": "^6.3.0",
    "chalk": "^6.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.13.0",
    "less": "^4.9.1",
    "mocha": "^12.0.3",
    "node-fetch": "^3.3.2",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "supertest": "^7.3.1"
  }
}
